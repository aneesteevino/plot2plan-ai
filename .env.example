# Copy to .env.local for local development. Never commit real values.

# MongoDB Atlas connection string (server-side only). Leave empty to run in
# browser-storage mode (projects saved in each visitor's browser only).
MONGODB_URI=
# Database name (optional, defaults to "plot2plan")
MONGODB_DB=plot2plan

# OpenRouter API key (server-side only). Used first; only free ":free" models are called.
OPENROUTER_API_KEY=
# Optional comma-separated overrides (keep ":free" models to avoid charges)
OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,minimax/minimax-m3.1-flash:free
OPENROUTER_TEXT_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# Hugging Face access token (fallback provider) with "Make calls to Inference Providers" permission
# (server-side only). Leave empty to disable AI assistance; the planner still works.
HF_TOKEN=
# Optional model overrides (must be available via Hugging Face Inference Providers)
HF_VISION_MODEL=Qwen/Qwen3.8-27B
HF_TEXT_MODEL=Qwen/Qwen3.8-27B
